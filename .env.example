# Backend-only Supabase credentials. Never expose SUPABASE_SECRET_KEY to a Vite app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Admin emails permitted to manage reservations and schedules.
ADMIN_EMAILS=admin@example.com

# Exact public origins for the independently hosted frontends.
CORS_ORIGINS=https://your-client-site.example,https://your-admin-site.example

# Local backend port; most hosting services set PORT automatically.
PORT=5000
